# Dependencies and package-manager state
**/node_modules/
**/.pnp
**/.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / frontend build output
/frontend/.next/
/frontend/out/
/frontend/build/
/.vercel/

# Testing and coverage
**/coverage/

# Miscellaneous
.DS_Store
*.pem
nul

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files — never commit secrets
.env
.env.*
!.env.example
!.env.*.example

# TypeScript
**/*.tsbuildinfo
**/next-env.d.ts

# Python / FastAPI backend
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
backend/*.egg-info/
*.pyc
*.pyo
