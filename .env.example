# Backend URL (set to switch from mock to live API)
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Spline 3D hero scene (optional)
# Set to a Spline scene share/embed URL to load the 3D scene on the landing
# hero. Leave empty to use the built-in Mg HCP crystal fallback.
NEXT_PUBLIC_SPLINE_SCENE_URL=

# Auth session signing secret (server-side only — NEVER expose to the client)
# Required in production. A dev-only fallback is used when unset locally.
AUTH_SECRET=
