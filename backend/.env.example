APP_NAME=CoatLab Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000

FRONTEND_URL=http://localhost:3333
ALLOWED_ORIGINS=http://localhost:3333

# LangSmith tracing (optional — set a real key to enable; leave blank to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=CoatLab
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=

# Google AI (Gemini) — required for the LangChain agent
GOOGLE_API_KEY=

MODEL_DIR=./models
DATA_DIR=./data

MAX_UPLOAD_SIZE_MB=10
