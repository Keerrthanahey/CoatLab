# ==============================
# CoatLab Backend Configuration
# ==============================

# FastAPI
APP_NAME=CoatLab Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# ==============================
# Frontend / CORS
# ==============================

FRONTEND_URL=http://localhost:3333
ALLOWED_ORIGINS=http://localhost:3333

# ==============================
# LangSmith Tracing
# ==============================
# Set LANGCHAIN_API_KEY (or LANGSMITH_API_KEY) to enable tracing.
# Traces will appear in the project set by LANGCHAIN_PROJECT.

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=CoatLab

# Aliases (also supported):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=CoatLab

# ==============================
# Google Gemini (for LangChain agent)
# ==============================

GOOGLE_API_KEY=your-google-api-key-here

# ==============================
# ML Configuration
# ==============================

MODEL_DIR=./models
DATA_DIR=./data

# ==============================
# File Upload
# ==============================

MAX_UPLOAD_SIZE_MB=10